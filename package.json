{
  "name": "iconium",
  "version": "1.0.0",
  "description": "Icon library - search and display icons from iconium-core API",
  "type": "module",
  "main": "dist/iconium.cjs",
  "module": "dist/iconium.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/iconium.mjs",
      "require": "./dist/iconium.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && vite build --config vite.cdn.config.ts",
    "prepublishOnly": "npm run build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:IvandevJaimes/iconium.git"
  },
  "keywords": [
    "icons",
    "svg",
    "react",
    "icon-library"
  ],
  "author": "ivanj.dev",
  "license": "ISC",
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.3",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^5.0.0"
  }
}
