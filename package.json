{
  "name": "iconium-react",
  "version": "1.0.3",
  "description": "React icon library powered by the iconium-core API (5,800+ icons)",
  "type": "module",
  "main": "dist/iconium.cjs",
  "module": "dist/iconium.mjs",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/iconium.mjs",
      "require": "./dist/iconium.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "prepublishOnly": "npm run build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IvandevJaimes/iconium.git"
  },
  "keywords": [
    "icons",
    "svg",
    "react",
    "icon-library",
    "icon",
    "thesvg"
  ],
  "author": "ivanj.dev",
  "license": "ISC",
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.58.12",
    "@types/node": "^25.6.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.3",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^5.0.0"
  }
}
